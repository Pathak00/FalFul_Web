# .NET build artifacts
bin/
obj/
*.user
*.suo
.vs/
*.swp

# Publish output
publish/
out/

# Secrets — only the base appsettings.json (with empty placeholders) is tracked.
# Environment-specific files (appsettings.Development.json, appsettings.Production.json, etc.)
# are gitignored. Set secrets via Azure App Service Application Settings or local env vars.
appsettings.*.json
!appsettings.json

# Angular (each package has its own .gitignore, this is a safety net)
**/node_modules/
**/.angular/cache/
**/dist/

# OS
.DS_Store
Thumbs.db

# Test results
TestResults/
coverage/
